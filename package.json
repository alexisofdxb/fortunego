{
  "name": "plotgo",
  "private": true,
  "version": "0.1.0",
  "description": "Founder Plot — 35-hex financial board. Place cards, earn Cash, hunt stock fragments.",
  "scripts": {
    "dev": "pnpm --parallel --filter @plotgo/api --filter @plotgo/web dev",
    "dev:api": "pnpm --filter @plotgo/api dev",
    "dev:web": "pnpm --filter @plotgo/web dev",
    "simulate:performance": "pnpm --filter @plotgo/api exec tsx ../../scripts/simulate_performance.ts",
    "build": "pnpm -r build",
    "test:balance": "pnpm --filter @plotgo/api exec tsx ../../scripts/balance_regression.ts",
    "test:onboarding": "pnpm --filter @plotgo/api exec tsx ../../scripts/onboarding_acceptance.ts",
    "test:visits": "pnpm --filter @plotgo/api exec tsx ../../scripts/visits_acceptance.ts",
    "test:retention": "pnpm --filter @plotgo/api exec tsx ../../scripts/retention_acceptance.ts",
    "test:land": "pnpm --filter @plotgo/api exec tsx ../../scripts/land_fit_acceptance.ts",
    "test:progression": "pnpm --filter @plotgo/api exec tsx ../../scripts/progression_v10_acceptance.ts",
    "test:auth": "pnpm --filter @plotgo/api exec tsx ../../scripts/auth_acceptance.ts",
    "test:hex": "pnpm --filter @plotgo/api exec tsx ../../scripts/hex_board_acceptance.ts",
    "db:push": "pnpm --filter @plotgo/api db:migrate",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
