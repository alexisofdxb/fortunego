DATABASE_URL="postgresql://plotgo:plotgo@localhost:5434/plotgo"
PORT=8787
ADMIN_TOKEN=change-me-to-a-long-random-string

# Auth: `dev` keeps the x-player-id prototype identity (local + CI);
# `privy` enables standalone Privy auth and requires the two values below.
PLOTGO_AUTH_MODE=dev
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Allowed browser origin for the standalone web app (optional; localhost dev is always allowed).
WEB_ORIGIN=http://localhost:5173
